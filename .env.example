# Copy to .env next to docker-compose.yml and fill in. See docs/DOCKER.md.

# Timezone for log timestamps (e.g. America/New_York, Europe/Berlin).
TZ=Etc/UTC

# Where the persistent config.yaml lives. The Unraid convention is under appdata.
DATA_DIR=/mnt/user/appdata/alexa-cameras

# --- Home Assistant (optional) -------------------------------------------------
# Only needed for the audio-injection {"text": "..."} mode, where Home Assistant
# renders the speech. Camera streaming, {"url": "..."} and {"test": true} all work
# without these.
#
# HA_URL is Home Assistant's address as seen from this container. If HA runs on the
# same Unraid box, that is the host's LAN IP — not "localhost", which would be this
# container itself.
HA_URL=http://192.168.1.100:8123

# A long-lived access token: Home Assistant -> your profile (bottom left) -> Security
# -> Long-lived access tokens -> Create token. Shown once; treat it as a password.
HA_TOKEN=
